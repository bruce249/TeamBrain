# Database (Supabase Postgres)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY="sk-or-..."

# AI Model — any model available on OpenRouter
# Examples: google/gemini-2.5-flash, anthropic/claude-sonnet-4, openai/gpt-4o, meta-llama/llama-4-scout
AI_MODEL="google/gemini-2.5-flash"

# Supabase (for Realtime)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
